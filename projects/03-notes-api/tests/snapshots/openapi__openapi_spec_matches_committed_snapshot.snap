---
source: projects/03-notes-api/tests/openapi.rs
expression: doc
---
{
  "components": {
    "schemas": {
      "CreateBody": {
        "example": {
          "body": "remember the milk"
        },
        "properties": {
          "body": {
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      },
      "NoteDto": {
        "example": {
          "body": "remember the milk",
          "created_at": "2026-05-26T10:00:00Z",
          "id": 42
        },
        "properties": {
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "body",
          "created_at"
        ],
        "type": "object"
      },
      "NotesPage": {
        "description": "One page of notes plus the opaque cursor a client uses to fetch the\nnext page. `next` is `None` when the caller has reached the end.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NoteDto"
            },
            "type": "array"
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "description": "RFC 7807 problem-details — the wire shape every error path returns.\nMade `pub` so utoipa can reference it from the `OpenAPI` doc.",
        "example": {
          "detail": "note 999 not found",
          "request_id": "01HXYZ…",
          "status": 404,
          "title": "Not Found",
          "type": "https://memberclub.test/problems/not-found"
        },
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "type": "object"
      },
      "UpdateBody": {
        "properties": {
          "body": {
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Phase 4 capstone — Axum CRUD over the sqlx-notes data layer.",
    "license": {
      "name": "MIT OR Apache-2.0"
    },
    "title": "notes-api"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/notes": {
      "get": {
        "operationId": "list_notes",
        "parameters": [
          {
            "description": "page size, clamped to [1, 100], default 20",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "opaque cursor from a previous `next`",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotesPage"
                }
              }
            },
            "description": "one page of notes"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "cursor was malformed"
          }
        },
        "tags": [
          "notes"
        ]
      },
      "post": {
        "operationId": "create_note",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteDto"
                }
              }
            },
            "description": "the note was created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "body is empty or too long"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "request body exceeded 8 KiB"
          }
        },
        "tags": [
          "notes"
        ]
      }
    },
    "/v1/notes/{id}": {
      "delete": {
        "operationId": "delete_note",
        "parameters": [
          {
            "description": "id of the note",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "the note was deleted"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "no such id"
          }
        },
        "tags": [
          "notes"
        ]
      },
      "get": {
        "operationId": "get_note",
        "parameters": [
          {
            "description": "id of the note",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteDto"
                }
              }
            },
            "description": "the note"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "no such id"
          }
        },
        "tags": [
          "notes"
        ]
      },
      "patch": {
        "operationId": "update_note",
        "parameters": [
          {
            "description": "id of the note",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteDto"
                }
              }
            },
            "description": "the updated note"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "body invalid"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "no such id"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "request body exceeded 8 KiB"
          }
        },
        "tags": [
          "notes"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "CRUD over the notes resource.",
      "name": "notes"
    }
  ]
}
