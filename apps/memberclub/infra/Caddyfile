# MemberClub single-box reverse proxy.
#
# Caddy handles automatic HTTPS via Let's Encrypt; just point your DNS
# at the host's public IP and set MEMBERCLUB_DOMAIN before bringing up
# the stack. Localhost works without a domain.

{$MEMBERCLUB_DOMAIN:localhost} {
    encode zstd gzip

    # API on a stable subpath. Strip the prefix before forwarding so the
    # backend sees the routes it expects (`/v1/notes`, not `/api/v1/notes`).
    handle_path /api/* {
        reverse_proxy api:3000
    }

    # Stripe webhooks are bound to a dedicated path so a leaked CDN
    # configuration can't accidentally route them elsewhere.
    handle /webhooks/stripe {
        reverse_proxy api:3000
    }

    # Everything else goes to the SvelteKit app.
    handle {
        reverse_proxy web:3000
    }

    # Don't leak the upstream Server header.
    header -Server
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
}
