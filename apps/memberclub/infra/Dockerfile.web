# MemberClub Web — SvelteKit adapter-node release image.

# ---------------------------------------------------------------------------
# Stage 1 — builder
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder

WORKDIR /work

# Enable pnpm via corepack (Node 22 ships it).
RUN corepack enable

COPY apps/memberclub/web/package.json apps/memberclub/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY apps/memberclub/web/ ./
RUN pnpm build

# Prune dev deps so the runtime image stays small.
RUN pnpm prune --prod

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

WORKDIR /app

# adapter-node produces a `build/` directory that's the app entrypoint.
COPY --from=builder /work/build ./build
COPY --from=builder /work/node_modules ./node_modules
COPY --from=builder /work/package.json ./

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

USER node
CMD ["node", "build"]
