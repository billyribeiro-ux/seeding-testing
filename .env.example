# Copy to .env and edit. The .env file is gitignored.

# --- Postgres (matches compose.yaml service "db") ---
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Mail (MailHog catches everything in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MemberClub <no-reply@memberclub.test>"

# --- Auth ---
SESSION_SECRET=change-me-to-a-32-byte-base64-secret-please
JWT_ISSUER=memberclub-dev
JWT_AUDIENCE=memberclub-api
# Path to an RSA private key (PEM) for signing JWTs. See phase-06 to generate one.
JWT_PRIVATE_KEY_PATH=./apps/memberclub/api/dev-keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./apps/memberclub/api/dev-keys/jwt-public.pem

# --- Stripe (test mode only, never put live keys in .env) ---
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_ELITE=price_replace_me

# --- App ---
APP_BIND=0.0.0.0:3000
RUST_LOG=info,sqlx::query=warn,tower_http=info
